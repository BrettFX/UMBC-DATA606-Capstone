# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/
.conda/

# --- Environment / secrets ---
.env
.env.*

# --- Jupyter ---
.ipynb_checkpoints/

# --- Datasets & model caches ---
# Keep the folder structure (README.md placeholders) but ignore downloaded
# contents under data/, plus any local Hugging Face cache dirs.
data/raw/**
data/processed/**
data/samples/**
!data/**/README.md
!data/README.md

.cache/
huggingface/
*.lock

# --- Large model / weight files ---
*.bin
*.safetensors
*.ckpt
*.pt
*.pth
*.h5
*.onnx
*.pkl

# --- Large media / audio (raw ATC recordings) ---
*.wav
*.flac
*.mp3
# Deliberate, scoped exception: a handful of short illustrative clips saved by
# the proposal EDA notebook so they play natively on GitHub (see res/README.md).
!res/audio_samples/*.wav
# Bundled demo clips for the ClearanceIQ app (built by scripts/build_app_samples.py, ~3 MB)
!app/samples/*.wav

# --- OS / editor cruft ---
.DS_Store
Thumbs.db
.vscode/
models/
~$*.*

# --- Run logs (training / annotation runs write here) ---
res/logs/

# --- ClearanceIQ e2e test scratch screenshots (regenerated on every run; curated ones live in app/docs/screenshots/) ---
app/tests/e2e/shots/
.pytest_cache/
